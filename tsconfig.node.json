{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo", // 指定tsbuildinfo文件的路径
    "target": "ES2022", // 编译目标
    "lib": ["ES2023"], // 编译时需要包含的库
    "module": "ESNext", // 指定模块代码生成
    "skipLibCheck": true, // 跳过库文件的类型检查

    /* Bundler mode */
    "moduleResolution": "Bundler", // 使用Bundler模式解析模块
    "allowImportingTsExtensions": true, // 允许导入带有.ts扩展名的模块
    "isolatedModules": true, // 每个文件都是独立模块
    "moduleDetection": "force", // 强制使用文件扩展名来检测模块
    "noEmit": true, // 不生成输出文件

    /* Linting */
    "strict": false, // 启用所有严格类型检查选项
    "noUnusedLocals": false, // 检查未使用的局部变量
    "noUnusedParameters": false, // 检查未使用的参数
    "noFallthroughCasesInSwitch": true, // 防止switch语句中的case没有break
    "noUncheckedSideEffectImports": true, // 在导入时检查未知的类型
    "baseUrl": ".", // 解析非相对模块名称的基准目录
    "paths": {
      // 模块名称到基于 baseUrl 的路径映射
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "element-plus/global"] // element-plus指定全局组件类型
  },
  "include": ["vite.config.ts", "types/**/*.d.ts"]
}
